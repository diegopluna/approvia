{
  "name": "@approvia/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "pnpm expense:db:generate",
    "expense:db:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://approvia:approvia@localhost:5433/approvia?schema=public} prisma generate --config apps/expense/prisma.config.ts",
    "expense:db:migrate": "DATABASE_URL=${DATABASE_URL:-postgresql://approvia:approvia@localhost:5433/approvia?schema=public} prisma migrate dev --config apps/expense/prisma.config.ts && pnpm expense:db:generate",
    "expense:db:deploy": "DATABASE_URL=${DATABASE_URL:-postgresql://approvia:approvia@localhost:5433/approvia?schema=public} prisma migrate deploy --config apps/expense/prisma.config.ts",
    "dev:gateway": "nx serve gateway",
    "dev:expense": "DATABASE_URL=${DATABASE_URL:-postgresql://approvia:approvia@localhost:5433/approvia?schema=public} nx serve expense",
    "dev:frontend": "nx serve frontend -- --proxy-config apps/frontend/proxy.conf.json",
    "test:all": "nx test frontend && nx e2e gateway-e2e",
    "test:auth": "nx test frontend && nx e2e gateway-e2e"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/core": "~21.2.0",
