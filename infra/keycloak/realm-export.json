{
  "realm": "approvia",
  "enabled": true,
  "loginWithEmailAllowed": true,
  "roles": { "realm": [{ "name": "user" }, { "name": "approver" }] },
  "clients": [
    {
      "clientId": "frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "protocolMappers": [
        {
          "name": "gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "gateway",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true
    },
    {
      "clientId": "notifications",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "notifications-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "test@approvia.dev",
      "email": "test@approvia.dev",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "password123", "temporary": false }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "diego.peter@pitang.com",
      "email": "diego.peter@pitang.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Diego",
      "lastName": "Luna",
      "credentials": [
        { "type": "password", "value": "password123", "temporary": false }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "approver@approvia.dev",
      "email": "approver@approvia.dev",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Alex",
      "lastName": "Approver",
      "credentials": [
        { "type": "password", "value": "password123", "temporary": false }
      ],
      "realmRoles": ["user", "approver"]
    },
    {
      "username": "service-account-notifications",
      "enabled": true,
      "serviceAccountClientId": "notifications",
      "clientRoles": {
        "realm-management": ["query-users", "view-realm", "view-users"]
      }
    }
  ]
}
