generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model PurchaseRequest {
  id                String                @id @default(uuid()) @db.Uuid
  title             String                @db.VarChar(120)
  justification     String                @db.VarChar(1000)
  amountMinor       Int                   @map("amount_minor")
  currency          String                @default("BRL") @db.Char(3)
  status            PurchaseRequestStatus @default(PENDING)
  requesterId       String                @map("requester_id") @db.VarChar(255)
  requesterName     String                @map("requester_name") @db.VarChar(255)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedById       String?               @map("decided_by_id") @db.VarChar(255)
  decidedByName     String?               @map("decided_by_name") @db.VarChar(255)
  decisionComment   String?               @map("decision_comment") @db.VarChar(1000)
  decidedAt         DateTime?             @map("decided_at") @db.Timestamptz(3)

  @@index([requesterId, createdAt])
  @@index([status, createdAt])
  @@map("purchase_requests")
}
