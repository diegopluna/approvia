{
  "name": "expense",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/expense/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-prisma"],
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/expense"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        }
      }
    },
    "generate-prisma": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/apps/expense/src/generated/prisma"],
      "options": {
        "command": "pnpm expense:db:generate"
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "expense:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "expense:build:development"
        },
        "production": {
          "buildTarget": "expense:build:production"
        }
      }
    }
  }
}
