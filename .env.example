KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=approvia
KEYCLOAK_AUDIENCE=gateway
KEYCLOAK_REQUIRED_ROLE=user

DATABASE_URL=postgresql://approvia:approvia@localhost:5433/approvia?schema=public
NOTIFICATIONS_DATABASE_URL=postgresql://approvia:approvia@localhost:5433/approvia?schema=notifications
NOTIFICATIONS_DATABASE_SCHEMA=notifications
DATABASE_PORT=5433

RABBITMQ_URL=amqp://approvia:approvia@localhost:5672
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
EXPENSE_SERVICE_QUEUE=expense
EXPENSE_SERVICE_QUEUE_DURABLE=true
EXPENSE_SERVICE_TIMEOUT_MS=5000
EXPENSE_SERVICE_PREFETCH=16
OUTBOX_PUBLISH_INTERVAL_MS=1000
OUTBOX_PUBLISH_TIMEOUT_MS=5000

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
WORKFLOWS_ENABLED=true
APPROVAL_DECISION_TTL_HOURS=120
APPROVAL_REMINDER_DELAY_HOURS=24
APPROVAL_REMINDER_INTERVAL_HOURS=24

NOTIFICATIONS_QUEUE=notifications.email.v1
NOTIFICATIONS_PREFETCH=5
NOTIFICATIONS_PUBLISH_TIMEOUT_MS=5000
NOTIFICATIONS_CLAIM_TIMEOUT_MS=300000

KEYCLOAK_NOTIFICATIONS_CLIENT_ID=notifications
KEYCLOAK_NOTIFICATIONS_CLIENT_SECRET=notifications-secret
KEYCLOAK_APPROVER_ROLE=approver
KEYCLOAK_RECIPIENT_CACHE_MS=300000
KEYCLOAK_REQUEST_TIMEOUT_MS=5000

EMAIL_PROVIDER=smtp
EMAIL_FROM="Approvia <noreply@approvia.local>"
FRONTEND_URL=http://localhost:4200
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
